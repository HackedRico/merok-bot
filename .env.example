# Copy to .env. Every value has a local default; the app runs with none of these set.

# Data: "local" reads .cache/ (fill it with scripts/pull_month.py); "fixture" reads tests/fixtures/.
MEROK_DATA_SOURCE=local

# Model seam: any OpenAI-compatible endpoint. Featherless, Gemini, Anthropic and OpenAI all speak it.
# Development model on Featherless (checked 2026-09-19): unsloth/Meta-Llama-3.1-8B-Instruct, $0.20 in and
# $0.32 out per million tokens, ungated, a draft costs well under a cent. meta-llama/Meta-Llama-3.1-8B-Instruct
# is 4x cheaper but gated: connect Hugging Face to the Featherless account first. For demo quality:
# Qwen/Qwen2.5-72B-Instruct, ungated, $0.37 in and $0.40 out.
MEROK_LLM_BASE_URL=https://api.featherless.ai/v1
MEROK_LLM_API_KEY=
MEROK_LLM_MODEL=unsloth/Meta-Llama-3.1-8B-Instruct

# Embeddings: "hash" needs no download; "nomic" needs `uv sync --extra nomic` and a 500 MB model.
MEROK_EMBEDDER=hash

# Render seams. "silent" and "loops" run offline. Part 2: "elevenlabs" and "veo".
MEROK_VOICE=silent
MEROK_VISUALS=loops

# Ship and Learn seams. "dry_run" and "replay" run offline. Part 2: "x" needs X API keys.
MEROK_PUBLISHER=dry_run
MEROK_POLLER=replay

# Demo user: an official congressional account from the government set.
MEROK_DEMO_HANDLE=sensanders

# How many of the newest cached hour files the app loads at startup (about one hour each).
MEROK_WINDOW_FILES=6

# Where rendered clips and the local DuckDB cache live.
MEROK_CACHE_DIR=.cache
